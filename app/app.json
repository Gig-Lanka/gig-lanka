{
  "expo": {
    "name": "Gig Lanka",
    "slug": "gig-lanka",
    "owner": "giglanka",
    "scheme": "giglanka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.giglanka.app"
    },
    "android": {
      "package": "com.giglanka.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF4A1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#101114"
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#FF4A1C",
                "dark": "#FF4A1C"
              },
              "colorControlActivated": {
                "light": "#FF4A1C",
                "dark": "#FF4A1C"
              },
              "textColorPrimary": {
                "light": "#101114",
                "dark": "#101114"
              },
              "windowBackground": {
                "light": "#FFFFFF",
                "dark": "#FFFFFF"
              }
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gig Lanka uses your photo library to set your profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d374b145-9bad-4def-bb27-e6e4f2be2859"
      }
    }
  }
}
