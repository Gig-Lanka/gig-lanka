NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/gig-lanka?appName=Cluster0

JWT_ACCESS_SECRET=<change-me-access-secret>
JWT_REFRESH_SECRET=<change-me-refresh-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SUPABASE_URL=<https://your-project.supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<change-me-supabase-service-role-key>
SUPABASE_BUCKET_NAME=<change-me-supabase-bucket-name>
